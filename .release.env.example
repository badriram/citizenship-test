# Copy to .release.env and fill in. .release.env is gitignored.
# Get ASC_ISSUER_ID from App Store Connect > Users and Access > Integrations.
# The .p8 private key is downloaded once at key creation and never committed.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_DIR=$(HOME)/.appstoreconnect/private_keys
TEAM_ID=XXXXXXXXXX
